{
  "name": "dsh-restart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restart the DSH desktop app from the sidebar More menu or the /restart command.",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "restart.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "check": "node --check index.js && node --check restart.js && node --check client.js"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
